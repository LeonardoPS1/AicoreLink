# --- Base de datos ---
# Base separada dentro de la misma instancia Postgres.
# En producción (Dokploy/Docker Swarm) usar IP interna: 172.18.0.1
DATABASE_URL=postgresql://user:pass@172.18.0.1:5432/dbname

# --- NextAuth ---
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-domain.com

# --- Encriptación de credenciales ---
ENCRYPTION_KEY=

# --- Billing ---
BILLING_WEBHOOK_SECRET=

# --- Meta WhatsApp Cloud API ---
# Token de acceso permanente (no expira) de la app Meta Business
META_CLOUD_API_TOKEN=
# Token de verificación del webhook (el que pones en Meta Developer Console)
META_VERIFY_TOKEN=
# App Secret de Meta (para verificar firma X-Hub-Signature-256)
META_APP_SECRET=
# Phone Number ID (opcional, solo si usas un número compartido para pruebas)
META_PHONE_NUMBER_ID=

# --- IA ---
# OpenRouter API Key (modelos cloud: GLM, etc.)
OPENROUTER_API_KEY=
# Ollama base URL (default apunta al contenedor en Docker network)
OLLAMA_BASE_URL=http://172.18.0.1:11434

# --- n8n Webhook URL ---
# URL del webhook n8n que orquesta el procesamiento
N8N_WHATSAPP_WEBHOOK_URL=

# --- Landing leads ---
# Webhook de n8n que avisa al equipo cuando entra un lead desde la landing.
# Vacío = la notificación se omite en silencio (el lead igual se guarda en la DB).
N8N_LEADS_WEBHOOK_URL=
# Secreto compartido para firmar el payload (header x-signature, HMAC-SHA256).
# Vacío = se envía sin firma.
N8N_LEADS_WEBHOOK_SECRET=

# --- WhatsApp Voz ---
# Whisper ASR URL (contenedor onerahmet/openai-whisper-asr-webservice)
WHISPER_URL=http://172.18.0.1:9000
# ElevenLabs API Key para TTS
ELEVENLABS_API_KEY=
# ElevenLabs Voice ID (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM