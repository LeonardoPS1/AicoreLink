# --- Base de datos (Fase 0) ---
# Base separada dentro de la misma instancia Postgres que usa AiCoreMed.
# En producción (Dokploy/Docker Swarm) usar IP interna: 172.18.0.1
AICORELINK_DATABASE_URL=postgresql://aicorelink_app:AicoreLink2024SecurePass@172.18.0.1:5432/aicorelink

# --- NextAuth (Fase 0) ---
# Genera con: openssl rand -base64 32
AICORELINK_NEXTAUTH_SECRET=
AICORELINK_NEXTAUTH_URL=https://aicorelink.aicorebots.com
# NextAuth internamente tambien busca NEXTAUTH_URL sin prefijo para ciertos
# redirects server-side; setea AMBAS variables con el mismo valor en Dokploy.
NEXTAUTH_URL=https://aicorelink.aicorebots.com

# --- Encriptacion de credenciales de canal (usada desde la Fase 1 en adelante) ---
AICORELINK_ENCRYPTION_KEY=

# --- Billing (placeholder, completar segun proveedor elegido) ---
AICORELINK_BILLING_WEBHOOK_SECRET=

# --- Meta WhatsApp Cloud API (Fase 1) ---
# Token de acceso permanente (no expira) de la app Meta Business
AICORELINK_META_CLOUD_API_TOKEN=
# Token de verificacion del webhook (el que pones en Meta Developer Console)
AICORELINK_META_VERIFY_TOKEN=
# App Secret de Meta (para verificar firma X-Hub-Signature-256)
AICORELINK_META_APP_SECRET=
# Phone Number ID (opcional, solo si usas un numero compartido para pruebas)
AICORELINK_META_PHONE_NUMBER_ID=

# --- IA (Fase 1) ---
# OpenRouter API Key (modelos cloud: GLM, etc.)
AICORELINK_OPENROUTER_API_KEY=
# Ollama base URL (default apunta al contenedor en Docker network)
AICORELINK_OLLAMA_BASE_URL=http://172.18.0.1:11434

# --- n8n Webhook URL (Fase 1) ---
# URL del webhook n8n que orquesta el procesamiento
AICORELINK_N8N_WHATSAPP_WEBHOOK_URL=

# --- WhatsApp Voz (Fase 2) ---
# Whisper ASR URL (contenedor onerahmet/openai-whisper-asr-webservice)
AICORELINK_WHISPER_URL=http://172.18.0.1:9000
# ElevenLabs API Key para TTS
AICORELINK_ELEVENLABS_API_KEY=
# ElevenLabs Voice ID (default: Rachel)
AICORELINK_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
