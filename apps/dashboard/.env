# --- Base de datos (Fase 0) ---
# Base separada dentro de la misma instancia Postgres que usa AiCoreMed.
# Usa IP interna de Docker (172.18.0.1) para conexión dentro de la red swarm
AICORELINK_DATABASE_URL=postgresql://aicorelink_app:AicoreLink2024!AppPass@172.18.0.1:5432/aicorelink

# --- NextAuth (Fase 0) ---
# Genera con: openssl rand -base64 32
AICORELINK_NEXTAUTH_SECRET=dev-secret-change-in-production-32chars-min
AICORELINK_NEXTAUTH_URL=https://aicorelink.aicorebots.com
# NextAuth internamente tambien busca NEXTAUTH_URL sin prefijo para ciertos
# redirects server-side; setea AMBAS variables con el mismo valor en Dokploy.
NEXTAUTH_URL=https://aicorelink.aicorebots.com

# --- Encriptacion de credenciales de canal (usada desde la Fase 1 en adelante) ---
AICORELINK_ENCRYPTION_KEY=

# --- Billing (placeholder, completar segun proveedor elegido) ---
AICORELINK_BILLING_WEBHOOK_SECRET=

# --- n8n Workflows (Phase 4) ---
AICORELINK_N8N_WEBHOOK_URL=https://aicorelink.aicorebots.com/api/webhooks/n8n

# --- IA Configuration (Phase 2-4) ---
AICORELINK_OLLAMA_BASE_URL=http://host.docker.internal:11434
AICORELINK_OPENROUTER_API_KEY=
AICORELINK_META_CLOUD_API_TOKEN=
