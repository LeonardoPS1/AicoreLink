# --- Base de datos ---
# Base separada dentro de la misma instancia Postgres.
# Usa IP interna de Docker (172.18.0.1) para conexión dentro de la red swarm
DATABASE_URL=postgresql://user:pass@172.18.0.1:5432/dbname

# --- NextAuth ---
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=dev-secret-change-in-production-32chars-min
NEXTAUTH_URL=https://your-domain.com

# --- Encriptación de credenciales ---
ENCRYPTION_KEY=

# --- Billing ---
BILLING_WEBHOOK_SECRET=

# --- n8n Workflows ---
N8N_WEBHOOK_URL=https://your-domain.com/api/webhooks/n8n

# --- Landing leads ---
N8N_LEADS_WEBHOOK_URL=
N8N_LEADS_WEBHOOK_SECRET=

# --- IA Configuration ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENROUTER_API_KEY=
META_CLOUD_API_TOKEN=
# --- Site ---
NEXT_PUBLIC_SITE_URL=https://aicorelink.aicorebots.com