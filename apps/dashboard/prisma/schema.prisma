generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("basico")
  status    String   @default("activo")
  createdAt DateTime @default(now()) @map("created_at")

  users            TenantUser[]
  channels         TenantChannel[]
  usage            TenantUsage[]
  credentials      ChannelCredential[]
  businessProfiles BusinessProfile[]
  sites            Site[]
  knowledgeBases   KnowledgeBase[]
  knowledgeBaseConfig KnowledgeBaseConfig?
  leads            Lead[]
  appointments     Appointment[]
  pilotOnboardings PilotOnboarding[]
  pilotFollowups   PilotFollowup[]
  testimonials     Testimonial[]
  billings         TenantBilling[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  // Rol interno de Aicore (dev_aicore | operador | soporte). Es global, no por
  // tenant: es lo que decide el panel, y tenant_id no alcanza para un rol
  // cross-tenant. Un usuario comun lo tiene en null y su rol sale de TenantUser.
  staffRole    String?  @map("staff_role")
  createdAt    DateTime @default(now()) @map("created_at")

  tenantLinks TenantUser[]

  @@index([staffRole])
  @@map("users")
}

model TenantUser {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  role      String   @default("cliente") // rol del usuario dentro del tenant: cliente | operador
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@map("tenant_users")
}

model TenantChannel {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  channel     String    // whatsapp_text | whatsapp_voice | email | social
  enabled     Boolean   @default(false)
  config      Json      @default("{}")
  descripcion String?   @map("descripcion")
  activatedAt DateTime? @map("activated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, channel])
  @@map("tenant_channels")
}

model ChannelCredential {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  channel         String
  provider        String
  externalId      String?  @map("external_id")
  encryptedSecret String   @map("encrypted_secret")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("channel_credentials")
}

model TenantUsage {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  channel        String
  period         DateTime
  messagesIn     Int      @default(0) @map("messages_in")
  messagesOut    Int      @default(0) @map("messages_out")
  tokensUsed     Int      @default(0) @map("tokens_used")
  costEstimate   Decimal  @default(0) @map("cost_estimate")
  model          String?
  version        String?
  firstResponseMs Int?    @map("first_response_ms")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, channel, period])
  @@map("tenant_usage")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  actorId   String?  @map("actor_id")
  action    String
  meta      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

model CostRate {
  id        String   @id @default(uuid())
  provider  String   // openrouter | meta_cloud_api | elevenlabs | whisper
  unit      String   // token | message | minute
  rate      Decimal
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cost_rates")
}

enum ThreadState {
  open
  escalated
  closed
}

model Conversation {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  externalId     String?     @map("external_id")
  channel        String      @default("whatsapp_text")
  contactRef     String      @map("contact_ref")
  status         String      @default("abierta")
  threadState    ThreadState @default(open) @map("thread_state")
  escalado       Boolean     @default(false)
  handoff        Boolean     @default(false)
  summary        String?     @db.Text
  escalatedAt    DateTime?   @map("escalated_at")
  closedAt       DateTime?   @map("closed_at")
  reactivatedAt  DateTime?   @map("reactivated_at")
  model          String?
  version        String?
  firstResponseMs Int?       @map("first_response_ms")
  createdAt      DateTime    @default(now()) @map("created_at")

  messages     Message[]
  appointments Appointment[]

  @@unique([tenantId, externalId])
  @@index([tenantId, threadState])
  @@map("conversations")
}

model Message {
  id                 String   @id @default(uuid())
  conversationId      String   @map("conversation_id")
  tenantId           String   @map("tenant_id")
  direction          String
  content            String
  aiGenerated        Boolean  @default(false) @map("ai_generated")
  tokensUsed         Int?     @map("tokens_used")
  createdAt          DateTime @default(now()) @map("created_at")
  mediaType          String?  @default("text") @map("media_type")
  audioUrl           String?  @map("audio_url")
  transcript         String?
  externalMessageId  String?  @map("external_message_id")
  model              String?
  version            String?
  firstResponseMs    Int?     @map("first_response_ms")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([tenantId, externalMessageId])
  @@map("messages")
}

/// Pre-sale enquiries submitted from the public landing page.
/// Tenant-less by design: these are not customer data, so no tenant_id and no RLS.
model LandingLead {
  id        String   @id @default(uuid())
  name      String
  business  String
  whatsapp  String
  vertical  String
  message   String?
  status    String   @default("new")
  source    String   @default("landing")
  userAgent String?  @map("user_agent")
  utmSource String?  @map("utm_source")
  utmMedium String?  @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmContent String? @map("utm_content")
  utmTerm   String?  @map("utm_term")
  consent   Boolean  @default(false) @map("consent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([status])
  @@index([utmSource])
  @@map("landing_leads")
}

/// Business profile for a tenant's site — contains all the business-specific content.
model BusinessProfile {
  id          String   @id @default(uuid())
  tenantId    String   @unique @map("tenant_id")
  rubro       String   // barberia | taller | profesional | clinica | inmobiliaria | domicilio
  name        String
  slug        String   @unique @map("slug")
  phone       String?
  email       String?
  address     String?
  description String?  @db.Text
  logoUrl     String?  @map("logo_url")
  images      String[] @default([]) @map("images")
  hours       Json     @default("{}") // { lunes: {open, close}, ... }
  team        Json     @default("[]") // [{name, role, bio, photoUrl}]
  services    Json     @default("[]") // [{name, description, priceCLP?, durationMin}]
  faqs        Json     @default("[]") // [{question, answer}]
  social      Json     @default("{}") // {instagram, facebook, tiktok, web}
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  site        Site?

  @@map("business_profiles")
}

/// A generated site for a tenant, linked to a template and optionally a business profile.
model Site {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  businessProfileId String?  @unique @map("business_profile_id")
  templateId        String   @map("template_id")
  name              String
  subdomain         String   @unique @map("subdomain") // e.g., "peluqueria-maria"
  customDomain      String?  @unique @map("custom_domain")
  status            String   @default("draft") // draft | generating | review | approved | published | unpublished
  currentVersionId  String?  @map("current_version_id")
  publishedAt       DateTime? @map("published_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  businessProfile   BusinessProfile? @relation(fields: [businessProfileId], references: [id])
  template          SiteTemplate @relation(fields: [templateId], references: [id])
  pages             SitePage[]
  versions          SiteVersion[]
  publishLogs       PublishLog[]

  @@index([tenantId])
  @@index([status])
  @@map("sites")
}

/// A page within a site, with portable JSON content (blocks).
model SitePage {
  id              String   @id @default(uuid())
  siteId          String   @map("site_id")
  templatePageId  String?  @map("template_page_id")
  path            String   // e.g., "/", "/servicios", "/equipo", "/contacto", "/reservar"
  title           String
  content         Json     // { blocks: [...] } — portable content (not HTML)
  meta            Json     @default("{}") // {title, description, ogImage, noindex}
  order           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, path])
  @@map("site_pages")
}

/// Template definition per rubro + plan tier.
model SiteTemplate {
  id          String   @id @default(uuid())
  rubro       String   // barberia | taller | profesional
  name        String
  planTier    String   // starter | growth | elite
  pageCount   Int      // 3, 5, or 10
  structure   Json     // [{path, title, blocksTemplate, requiredVariables}]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sites       Site[]
  pages       SiteTemplatePage[]

  @@unique([rubro, planTier])
  @@map("site_templates")
}

/// Page template within a SiteTemplate, with placeholder blocks.
model SiteTemplatePage {
  id                 String   @id @default(uuid())
  templateId         String   @map("template_id")
  path               String
  title              String
  blocksTemplate     Json     // template with {{variable}} placeholders
  requiredVariables  String[] @map("required_variables")
  order              Int      @default(0)

  template           SiteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, path])
  @@map("site_template_pages")
}

/// Version snapshot of a site's pages.
model SiteVersion {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  version   Int
  pages     Json     // full snapshot of pages at this version
  changelog String?  @map("changelog")
  createdBy String   @map("created_by") // userId
  createdAt DateTime @default(now()) @map("created_at")

  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, version])
  @@map("site_versions")
}

/// Audit log for publish/unpublish/rollback/domain change actions.
model PublishLog {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  version   Int
  action    String   // publish | unpublish | rollback | domain_change
  target    String   // subdomain or custom domain
  status    String   // success | failed | pending
  error     String?  @db.Text
  meta      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("publish_logs")
}

/// Structured knowledge base entries for a tenant (category, question, answer).
/// The assistant may only cite facts present in these rows (E3 KB, RF-KB-01..05).
model KnowledgeBase {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  category        String
  question        String
  answer          String   @db.Text
  tone            String?  @map("tone")
  forbiddenTopics String[] @default([]) @map("forbidden_topics")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, category])
  @@map("knowledge_bases")
}

/// Per-tenant configuration for the knowledge base assistant (tone + forbidden topics).
model KnowledgeBaseConfig {
  id              String   @id @default(uuid())
  tenantId        String   @unique @map("tenant_id")
  tone            String   @default("amable")
  forbiddenTopics String[] @default([]) @map("forbidden_topics")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("knowledge_base_configs")
}

/// Lead captured for a tenant (conversations, appointments). Tenant-scoped (RLS).
model Lead {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  email       String?
  phone       String?
  source      String
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  status      String   @default("nuevo")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("leads")
}

/// Appointment scheduled for a tenant, optionally linked to a conversation and lead.
model Appointment {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String?  @map("conversation_id")
  leadId         String?  @map("lead_id")
  scheduledAt    DateTime @map("scheduled_at")
  status         String   @default("pendiente")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("appointments")
}

/// Onboarding record for a pilot (Founder) tenant. Tracks provisioning checklist.
model PilotOnboarding {
  id                String    @id @default(cuid())
  tenantId          String    @unique @map("tenant_id")
  status            String    @default("pending") // pending | in_progress | completed | cancelled
  founderAgreement  Boolean   @default(false) @map("founder_agreement")
  checklist         Json      @default("{}") // { whatsapp_connected, kb_loaded, site_published, billing_active }
  assignedTo        String?   @map("assigned_to")
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("pilot_onboardings")
}

/// Follow-up record for pilot tenants (d1, d7, d14, d30).
model PilotFollowup {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  day         Int       // 1, 7, 14, 30
  sentAt      DateTime? @map("sent_at")
  respondedAt DateTime? @map("responded_at")
  score       Int?      // 1-5 (NPS-like)
  feedback    String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, day])
  @@map("pilot_followups")
}

/// Testimonial captured from a client tenant, approved/published by admin.
model Testimonial {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  authorName  String   @map("author_name")
  authorRole  String?  @map("author_role")
  content     String   @db.Text
  rating      Int      // 1-5
  approved    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([approved, published])
  @@map("testimonials")
}

/// Billing record for a tenant (subscription, invoices, payment status).
model TenantBilling {
  id            String    @id @default(cuid())
  tenantId      String    @unique @map("tenant_id")
  plan          String
  amount        Decimal   @default(0)
  currency      String    @default("CLP")
  status        String    @default("active") // active | past_due | suspended | cancelled
  billingActive Boolean   @default(true) @map("billing_active")
  invoiceNumber String?   @map("invoice_number")
  invoiceUrl    String?   @map("invoice_url")
  lastPaymentAt DateTime? @map("last_payment_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("tenant_billings")
}