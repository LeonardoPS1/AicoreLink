generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("basico")
  status    String   @default("activo")
  createdAt DateTime @default(now()) @map("created_at")

  users            TenantUser[]
  channels         TenantChannel[]
  usage            TenantUsage[]
  credentials      ChannelCredential[]
  businessProfiles BusinessProfile[]
  sites            Site[]
  knowledgeBases   KnowledgeBase[]
  knowledgeBaseConfig KnowledgeBaseConfig?
  leads            Lead[]
  appointments         Appointment[]
  availabilityBlocks   AvailabilityBlock[]
  pilotOnboardings     PilotOnboarding[]
  pilotFollowups   PilotFollowup[]
  testimonials     Testimonial[]
  billings         TenantBilling[]
  assistantConfig  AssistantConfig?
  correctionLogs   CorrectionLog[]
  branches         Branch[]
  reactivationCampaigns ReactivationCampaign[]
  supportTickets       SupportTicket[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  staffRole    String?  @map("staff_role")
  createdAt    DateTime @default(now()) @map("created_at")

  tenantLinks TenantUser[]
  passwordResetTokens PasswordResetToken[]

  @@index([staffRole])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model TenantUser {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  role      String   @default("cliente")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@map("tenant_users")
}

model TenantChannel {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  channel     String
  enabled     Boolean   @default(false)
  config      Json      @default("{}")
  descripcion String?   @map("descripcion")
  activatedAt DateTime? @map("activated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, channel])
  @@map("tenant_channels")
}

model ChannelCredential {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  channel         String
  provider        String
  externalId      String?  @map("external_id")
  encryptedSecret String   @map("encrypted_secret")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("channel_credentials")
}

model TenantUsage {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  channel        String
  period         DateTime
  messagesIn     Int      @default(0) @map("messages_in")
  messagesOut    Int      @default(0) @map("messages_out")
  tokensUsed     Int      @default(0) @map("tokens_used")
  costEstimate   Decimal  @default(0) @map("cost_estimate")
  model          String?
  version        String?
  firstResponseMs Int?    @map("first_response_ms")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, channel, period])
  @@map("tenant_usage")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  actorId   String?  @map("actor_id")
  action    String
  meta      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

model CostRate {
  id        String   @id @default(uuid())
  provider  String
  unit      String
  rate      Decimal
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cost_rates")
}

enum ThreadState {
  open
  escalated
  closed
}

model Conversation {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  externalId     String?     @map("external_id")
  channel        String      @default("whatsapp_text")
  contactRef     String      @map("contact_ref")
  status         String      @default("abierta")
  threadState    ThreadState @default(open) @map("thread_state")
  escalado       Boolean     @default(false)
  handoff        Boolean     @default(false)
  summary        String?     @db.Text
  escalatedAt    DateTime?   @map("escalated_at")
  closedAt       DateTime?   @map("closed_at")
  reactivatedAt  DateTime?   @map("reactivated_at")
  model          String?
  version        String?
  firstResponseMs Int?       @map("first_response_ms")
  createdAt      DateTime    @default(now()) @map("created_at")

  messages     Message[]
  appointments Appointment[]

  @@unique([tenantId, externalId])
  @@index([tenantId, threadState])
  @@map("conversations")
}

model Message {
  id                 String   @id @default(uuid())
  conversationId      String   @map("conversation_id")
  tenantId           String   @map("tenant_id")
  direction          String
  content            String
  aiGenerated        Boolean  @default(false) @map("ai_generated")
  tokensUsed         Int?     @map("tokens_used")
  createdAt          DateTime @default(now()) @map("created_at")
  mediaType          String?  @default("text") @map("media_type")
  audioUrl           String?  @map("audio_url")
  transcript         String?
  externalMessageId  String?  @map("external_message_id")
  model              String?
  version            String?
  firstResponseMs    Int?     @map("first_response_ms")

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([tenantId, externalMessageId])
  @@map("messages")
}

model LandingLead {
  id        String   @id @default(uuid())
  name      String
  business  String
  whatsapp  String
  vertical  String
  message   String?
  status    String   @default("new")
  source    String   @default("landing")
  userAgent String?  @map("user_agent")
  utmSource String?  @map("utm_source")
  utmMedium String?  @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmContent String? @map("utm_content")
  utmTerm   String?  @map("utm_term")
  consent   Boolean  @default(false) @map("consent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([status])
  @@index([utmSource])
  @@map("landing_leads")
}

model BusinessProfile {
  id          String   @id @default(uuid())
  tenantId    String   @unique @map("tenant_id")
  rubro       String
  name        String
  slug        String   @unique @map("slug")
  phone       String?
  email       String?
  address     String?
  description String?  @db.Text
  logoUrl     String?  @map("logo_url")
  images      String[] @default([]) @map("images")
  hours       Json     @default("{}")
  team        Json     @default("[]")
  services    Json     @default("[]")
  faqs        Json     @default("[]")
  social      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  site        Site?

  @@map("business_profiles")
}

model Site {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  businessProfileId String?  @unique @map("business_profile_id")
  templateId        String   @map("template_id")
  name              String
  subdomain         String   @unique @map("subdomain")
  customDomain      String?  @unique @map("custom_domain")
  status            String   @default("draft")
  currentVersionId  String?  @map("current_version_id")
  publishedAt       DateTime? @map("published_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  businessProfile   BusinessProfile? @relation(fields: [businessProfileId], references: [id])
  template          SiteTemplate @relation(fields: [templateId], references: [id])
  pages             SitePage[]
  versions          SiteVersion[]
  publishLogs       PublishLog[]

  @@index([tenantId])
  @@index([status])
  @@map("sites")
}

model SitePage {
  id              String   @id @default(uuid())
  siteId          String   @map("site_id")
  templatePageId  String?  @map("template_page_id")
  path            String
  title           String
  content         Json
  meta            Json     @default("{}")
  order           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, path])
  @@map("site_pages")
}

model SiteTemplate {
  id          String   @id @default(uuid())
  rubro       String
  name        String
  planTier    String
  pageCount   Int
  structure   Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sites       Site[]
  pages       SiteTemplatePage[]

  @@unique([rubro, planTier])
  @@map("site_templates")
}

model SiteTemplatePage {
  id                 String   @id @default(uuid())
  templateId         String   @map("template_id")
  path               String
  title              String
  blocksTemplate     Json
  requiredVariables  String[] @map("required_variables")
  order              Int      @default(0)

  template           SiteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, path])
  @@map("site_template_pages")
}

model SiteVersion {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  version   Int
  pages     Json
  changelog String?  @map("changelog")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, version])
  @@map("site_versions")
}

model PublishLog {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  version   Int
  action    String
  target    String
  status    String
  error     String?  @db.Text
  meta      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("publish_logs")
}

model KnowledgeBase {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  category        String
  question        String
  answer          String   @db.Text
  tone            String?  @map("tone")
  forbiddenTopics String[] @default([]) @map("forbidden_topics")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, category])
  @@map("knowledge_bases")
}

model KnowledgeBaseConfig {
  id              String   @id @default(uuid())
  tenantId        String   @unique @map("tenant_id")
  tone            String   @default("amable")
  forbiddenTopics String[] @default([]) @map("forbidden_topics")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("knowledge_base_configs")
}

model Lead {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  email       String?
  phone       String?
  source      String
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  status      String   @default("nuevo")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("leads")
}

model Appointment {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String?  @map("conversation_id")
  leadId         String?  @map("lead_id")
  professional   String?  @map("professional")
  scheduledAt    DateTime @map("scheduled_at")
  duration       Int      @default(30) @map("duration_minutes")
  status         String   @default("pendiente")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("appointments")
}

model AvailabilityBlock {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  reason    String?  @map("reason")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("availability_blocks")
}

model PilotOnboarding {
  id                String    @id @default(cuid())
  tenantId          String    @unique @map("tenant_id")
  status            String    @default("pending")
  founderAgreement  Boolean   @default(false) @map("founder_agreement")
  checklist         Json      @default("{}")
  assignedTo        String?   @map("assigned_to")
  startedAt         DateTime  @default(now()) @map("started_at")
  completedAt       DateTime? @map("completed_at")
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("pilot_onboardings")
}

model PilotFollowup {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  day         Int
  sentAt      DateTime? @map("sent_at")
  respondedAt DateTime? @map("responded_at")
  score       Int?
  feedback    String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, day])
  @@map("pilot_followups")
}

model Testimonial {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  authorName  String   @map("author_name")
  authorRole  String?  @map("author_role")
  content     String   @db.Text
  rating      Int
  approved    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([approved, published])
  @@map("testimonials")
}

model TenantBilling {
  id            String    @id @default(cuid())
  tenantId      String    @unique @map("tenant_id")
  plan          String
  amount        Decimal   @default(0)
  currency      String    @default("CLP")
  status        String    @default("active")
  billingActive Boolean   @default(true) @map("billing_active")
  invoiceNumber String?   @map("invoice_number")
  invoiceUrl    String?   @map("invoice_url")
  lastPaymentAt DateTime? @map("last_payment_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("tenant_billings")
}

model AssistantConfig {
  id            String   @id @default(uuid())
  tenantId      String   @unique @map("tenant_id")
  name          String   @default("Aicore Assistant")
  tone          String   @default("amable")
  language      String   @default("es")
  greeting      String?  @db.Text
  forbiddenTopics String[] @default([]) @map("forbidden_topics")
  autoReply     Boolean  @default(true) @map("auto_reply")
  handoffKeywords String[] @default([]) @map("handoff_keywords")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("assistant_configs")
}

model CorrectionLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  original      String   @db.Text
  correction    String   @db.Text
  context       String?  @db.Text
  applied       Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("correction_logs")
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("branches")
}

model ReactivationCampaign {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  audience    String   // all | inactive_30d | inactive_90d | custom
  message     String   @db.Text
  status      String   @default("draft") // draft | scheduled | running | completed
  scheduledAt DateTime? @map("scheduled_at")
  sentCount   Int      @default(0) @map("sent_count")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("reactivation_campaigns")
}

model SupportTicket {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  subject     String
  description String    @db.Text
  status      String    @default("open")
  priority    String    @default("normal")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  resolvedAt  DateTime? @map("resolved_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("support_tickets")
}
