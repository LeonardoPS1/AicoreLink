{
  "name": "Factory Publish",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "factory-publish",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-publish",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "factory-publish-webhook"
    },
    {
      "parameters": {
        "functionCode": "const data = $json.body || $json;\nconst required = ['jobId', 'siteId', 'tenantId', 'version', 'target'];\nfor (const key of required) {\n  if (data[key] === undefined || data[key] === null || data[key] === '') {\n    throw new Error(`Missing required field: ${key}`);\n  }\n}\nif (data.target === 'custom' && !data.customDomain) {\n  throw new Error('customDomain is required when target is custom');\n}\nreturn [{ json: data }];"
      },
      "id": "validate-payload",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXTAUTH_URL }}/api/factory/sites/{{ $json.siteId }}/publish-internal",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.FACTORY_INTERNAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jobId: $json.jobId, tenantId: $json.tenantId, version: Number($json.version), target: $json.target, customDomain: $json.customDomain || undefined }) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "id": "publish-site",
      "name": "Publish Site",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.success }}",
              "value2": true
            }
          ]
        }
      },
      "id": "check-result",
      "name": "Check Result",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXTAUTH_URL }}/api/admin/sites/{{ $json.siteId }}/publish-complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.FACTORY_INTERNAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jobId: $json.jobId, siteId: $json.siteId, tenantId: $json.tenantId, status: 'completed', domain: $json.domain }) }}",
        "options": {}
      },
      "id": "notify-success",
      "name": "Notify Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXTAUTH_URL }}/api/admin/sites/{{ $json.siteId }}/publish-complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.FACTORY_INTERNAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jobId: $json.jobId, siteId: $json.siteId, tenantId: $json.tenantId, status: 'failed', error: $json.error || $json.message || 'Publish failed' }) }}",
        "options": {}
      },
      "id": "notify-error",
      "name": "Notify Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 400]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Validate Payload", "type": "main", "index": 0 }]]
    },
    "Validate Payload": {
      "main": [[{ "node": "Publish Site", "type": "main", "index": 0 }]]
    },
    "Publish Site": {
      "main": [[{ "node": "Check Result", "type": "main", "index": 0 }]]
    },
    "Check Result": {
      "main": [
        [{ "node": "Notify Success", "type": "main", "index": 0 }],
        [{ "node": "Notify Error", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "id": "factory-publish-workflow",
  "tags": []
}
